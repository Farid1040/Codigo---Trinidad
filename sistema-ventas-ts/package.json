{
  "name": "sistema-ventas-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Ventas Web en TypeScript — replica del proyecto Java (NetBeans/GlassFish) sobre MySQL db_ventas",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist-server/index.js",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
